{
  "navigationFallback": { "rewrite": "/index.html", "exclude": ["/assets/*", "/*.json", "/sw.js"] },
  "routes": [
    { "route": "/sw.js", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/online.json", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/index.html", "headers": { "Cache-Control": "no-cache" } }
  ],
  "mimeTypes": { ".json": "application/json", ".webmanifest": "application/manifest+json" }
}
